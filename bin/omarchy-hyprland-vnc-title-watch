#!/bin/bash

# omarchy:summary=Title the VNC desktop after the focused window
# omarchy:hidden=true

# The VNC viewer window on the Windows desktop is titled from the RFB desktop
# name wayvnc advertises, which is otherwise fixed for the life of the session.
# That leaves the one window standing in for the whole desktop unable to say
# what is in it, while every other window on the taskbar names its document.
#
# wayvncctl sets the name at runtime; neatvnc flags each connected client and
# sends a DesktopName update, which the viewer applies to its title bar. So the
# title can follow focus the way a window manager's does.
#
# Only useful inside the WSL session, which is the only place wayvnc runs.
# omarchy-launch-wsl-session starts this once wayvnc is listening and kills it
# on the way out.

BASE_NAME="${1:-Omarchy}"
SOCKET="$XDG_RUNTIME_DIR/hypr/$HYPRLAND_INSTANCE_SIGNATURE/.socket2.sock"

# The longest a title may be before it is cut short. Nothing breaks above this;
# a taskbar entry is just no more readable for it.
MAX_TITLE=96

desktop_name() {
  local title

  title=$(hyprctl activewindow -j 2>/dev/null | jq -r '.title // empty')

  # A window title is not trustworthy input -- any web page picks its own, so
  # this is a remote string arriving over the session. It goes to wayvncctl as
  # a single argument and is never re-parsed by a shell, but control characters
  # and unbounded lengths have no business going onto the wire either way.
  title=${title//[[:cntrl:]]/}

  if ((${#title} > MAX_TITLE)); then
    title="${title:0:MAX_TITLE}…"
  fi

  if [[ -n $title ]]; then
    echo "$title — $BASE_NAME"
  else
    echo "$BASE_NAME"
  fi
}

# What wayvnc was started with, so the first focus does not re-send it.
last_name="$BASE_NAME"

while IFS= read -r event; do
  case "$event" in
    # activewindow carries the title itself, but a title that changes while the
    # window keeps focus arrives as windowtitle against an address instead --
    # matching that to the focused window means tracking activewindowv2 as
    # well. Asking Hyprland which window is active is shorter and always right.
    activewindow\>\>*|windowtitle\>\>*|windowtitlev2\>\>*|closewindow\>\>*) ;;
    *) continue ;;
  esac

  name=$(desktop_name)

  # A terminal retitles on every command; without this each one is an IPC round
  # trip and a framebuffer update to every connected client.
  [[ $name == "$last_name" ]] && continue
  last_name=$name

  wayvncctl set-desktop-name "$name" >/dev/null 2>&1
done < <(socat -U - "UNIX-CONNECT:$SOCKET")
