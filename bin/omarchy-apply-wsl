#!/bin/bash

# omarchy:summary=Apply Omarchy system setup inside a WSL image
# omarchy:group=apply
# omarchy:requires-sudo=true
# omarchy:examples=omarchy apply wsl --first-install --image
# omarchy:hidden=true

set -euo pipefail

usage() {
  cat <<USAGE
Usage: omarchy apply wsl [--image|--setup] [--install-user USER]
                         [--first-install|--upgrade]

The WSL counterpart of omarchy-apply-system, in two phases:

  --image   what the distributed .wsl tarball carries: the setup screen, the
            locale, and the metadata Windows reads at import time.
            omarchy-dev-wsl-build runs this in the build container.
  --setup   the rest of Omarchy — packages, the neatvnc build, configuration.
            /etc/oobe.sh runs this once on the user's machine.

With neither, both phases run in order, which is what an in-place re-apply on
an installed machine wants.

The desktop is not in the image because baking it in put the tarball past 5 GB
gzipped, more than a GitHub release asset may be. See docs/wsl.md.

With no --install-user it provisions without an account, the way a
deferred-provisioning ISO install does: /etc/oobe.sh creates the user on first
run instead. That is the normal path for a distributable image, because the
account name belongs to whoever imports it.

This deliberately does not call omarchy-apply-system. Five of its steps assume
hardware WSL does not have — see docs/wsl.md for the list and the reasoning.
USAGE
}

install_user="${OMARCHY_INSTALL_USER:-}"
first_install=0
upgrade=0
phase=all

while (($#)); do
  case "$1" in
    --install-user)
      install_user="${2:-}"
      shift 2
      ;;
    --image)
      phase=image
      shift
      ;;
    --setup)
      phase=setup
      shift
      ;;
    --first-install)
      first_install=1
      shift
      ;;
    --upgrade)
      upgrade=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

if (( EUID != 0 )); then
  echo "Error: omarchy-apply-wsl must run as root" >&2
  exit 1
fi

if [[ -n $install_user ]]; then
  if [[ $install_user == "root" ]]; then
    echo "Error: --install-user must name a non-root user" >&2
    exit 1
  fi

  if ! getent passwd "$install_user" >/dev/null; then
    echo "Error: user '$install_user' does not exist" >&2
    exit 1
  fi
fi

export OMARCHY_INSTALL_USER="$install_user"
export OMARCHY_FIRST_INSTALL="$first_install"
export OMARCHY_UPGRADE="$upgrade"
export OMARCHY_PATH="${OMARCHY_PATH:-/usr/share/omarchy}"
export OMARCHY_INSTALL="${OMARCHY_INSTALL:-$OMARCHY_PATH/install}"
export OMARCHY_INSTALL_LOG_FILE="${OMARCHY_INSTALL_LOG_FILE:-/var/log/omarchy-install.log}"
export PATH="$OMARCHY_PATH/bin:$PATH"

source "$OMARCHY_INSTALL/helpers/logging.sh"
start_install_log

case "$phase" in
  image) source "$OMARCHY_INSTALL/wsl/all-image.sh" ;;
  setup) source "$OMARCHY_INSTALL/wsl/all-setup.sh" ;;
  all)   source "$OMARCHY_INSTALL/wsl/all.sh" ;;
esac

stop_install_log
