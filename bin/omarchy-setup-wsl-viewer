#!/bin/bash

# omarchy:summary=Set up the Windows side of the WSL desktop: the VNC viewer and a desktop shortcut
# omarchy:group=setup
# omarchy:examples=omarchy setup wsl viewer

set -euo pipefail

# The WSL desktop is served by wayvnc and shown in a VNC client. A client
# running on Windows gets a native window and, more to the point, the Windows
# clipboard: wayvnc already carries the selection both ways over
# ext_data_control_manager_v1, but a viewer running inside WSL bridges that to
# Xwayland rather than to Windows.
#
# Windows ships no VNC client, so this fetches TigerVNC's standalone viewer --
# the same project and the same version as the tigervnc package in the image,
# and one that speaks the extended clipboard, which is what carries UTF-8.
#
# Nothing is installed on the Linux side and no Windows setting is changed:
# the viewer is a single executable dropped in the user's own AppData.

VIEWER_VERSION=1.16.2
VIEWER_SHA256=58396d99556026da6b906c9ed51ad6cb5c840cc3fb65e53653c52ca5a80bfad9
VIEWER_URL="https://sourceforge.net/projects/tigervnc/files/stable/$VIEWER_VERSION/vncviewer64-$VIEWER_VERSION.exe/download"

usage() {
  cat <<USAGE
Usage: omarchy setup wsl viewer [--force]

Downloads TigerVNC $VIEWER_VERSION's Windows viewer to your Windows profile, so
'startx' opens the Omarchy desktop in a native Windows window with a
shared clipboard.

  --force   re-download even when the viewer is already installed

Without it the desktop still opens, in the viewer inside WSL, which has no
access to the Windows clipboard.
USAGE
}

force=0

while (($#)); do
  case "$1" in
    --force)
      force=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

if [[ ! -d /mnt/c/Windows ]]; then
  echo "Error: this only applies to Omarchy running under WSL." >&2
  exit 1
fi

# The same interop idiom as default/wsl/oobe.sh: cmd.exe is what can answer,
# it prints a UNC working-directory warning first, and its output is CRLF.
local_app_data=$(/mnt/c/Windows/System32/cmd.exe /c "echo %LOCALAPPDATA%" 2>/dev/null | tail -1 | tr -d '\r\n')

if [[ -z $local_app_data ]]; then
  echo "Error: could not ask Windows where LOCALAPPDATA is." >&2
  echo "Check that interop is enabled in /etc/wsl.conf." >&2
  exit 1
fi

viewer_dir="$(wslpath -u "$local_app_data")/Omarchy"
viewer="$viewer_dir/vncviewer64.exe"

# The image build cannot create this: it runs in a container with no Windows to
# write to. So it happens here, alongside the viewer, as the other half of
# setting up the Windows side.
install_shortcut() {
  local icon_dir icon script

  # The shortcut has to name the distribution wsl.exe should start, and
  # WSL_DISTRO_NAME is the only thing that knows what this was imported as.
  # defaultName in /etc/wsl-distribution.conf is not a fallback: it is the name
  # the image asks for, which is not the name it necessarily got, so guessing
  # from it produces a shortcut that starts a different distribution.
  local distro="${WSL_DISTRO_NAME:-}"

  if [[ -z $distro ]]; then
    echo "Note: WSL_DISTRO_NAME is unset -- run this from a shell inside the" >&2
    echo "distribution so the shortcut names the right one. Nothing was created." >&2
    return 0
  fi

  icon_dir="$viewer_dir"
  icon="$icon_dir/omarchy.ico"

  # install/wsl/image.sh renders this from logo.svg for the Start menu entry
  # WSL creates; the same file serves the desktop shortcut.
  if [[ -f /usr/lib/wsl/omarchy.ico ]]; then
    install -Dm644 /usr/lib/wsl/omarchy.ico "$icon"
  fi

  # wslg.exe rather than wsl.exe: it launches without a console window, so no
  # terminal flashes up behind the desktop. bash -lc so the session starts from
  # a login shell, the way it does when the user types startx themselves.
  script=$(mktemp --suffix=.ps1)
  cat >"$script" <<PS1
\$desktop = [Environment]::GetFolderPath('Desktop')
\$link = Join-Path \$desktop 'Omarchy Desktop.lnk'
\$shell = New-Object -ComObject WScript.Shell
\$sc = \$shell.CreateShortcut(\$link)
\$sc.TargetPath = 'C:\\Program Files\\WSL\\wslg.exe'
\$sc.Arguments = '-d $distro --cd ~ -- bash -lc startx'
\$sc.IconLocation = "\$env:LOCALAPPDATA\\Omarchy\\omarchy.ico,0"
\$sc.Description = 'Start the Omarchy desktop in a window'
\$sc.WorkingDirectory = \$env:USERPROFILE
\$sc.Save()
Write-Output \$link
PS1

  local link
  link=$(/mnt/c/Windows/System32/WindowsPowerShell/v1.0/powershell.exe -NoProfile -ExecutionPolicy Bypass \
    -File "$(wslpath -w "$script")" 2>/dev/null | tail -1 | tr -d '\r\n')
  rm -f "$script"

  if [[ -n $link ]]; then
    echo "Created the desktop shortcut: $link"
  else
    echo "Note: could not create the desktop shortcut; 'startx' still works." >&2
  fi
}

installed() {
  [[ -f $viewer ]] && [[ $(sha256sum "$viewer" | cut -d' ' -f1) == "$VIEWER_SHA256" ]]
}

if (( ! force )) && installed; then
  echo "TigerVNC $VIEWER_VERSION is already installed at $viewer"
  install_shortcut
  echo "Run 'startx' to open the desktop."
  exit 0
fi

echo "Downloading TigerVNC $VIEWER_VERSION for Windows"

download=$(mktemp)
trap 'rm -f "$download"' EXIT

# SourceForge answers with a redirect to a mirror, hence -L.
if ! curl -fL --retry 3 --progress-bar -o "$download" "$VIEWER_URL"; then
  echo "Error: could not download the viewer from $VIEWER_URL" >&2
  exit 1
fi

# SourceForge publishes no signature for this file, so the digest is pinned
# here instead. It is what makes every run after the first one -- and every
# other machine -- safe from a substituted download.
actual=$(sha256sum "$download" | cut -d' ' -f1)

if [[ $actual != "$VIEWER_SHA256" ]]; then
  echo "Error: the download does not match the expected checksum; not installing it." >&2
  echo "  expected $VIEWER_SHA256" >&2
  echo "  got      $actual" >&2
  exit 1
fi

mkdir -p "$viewer_dir"
install -m755 "$download" "$viewer"

echo
echo "Installed $viewer"

install_shortcut

echo "Run 'startx' to open the Omarchy desktop in a Windows window."
