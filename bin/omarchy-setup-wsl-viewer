#!/bin/bash

# omarchy:summary=Set up the Windows side of the WSL desktop: the VNC viewer and a desktop shortcut
# omarchy:group=setup
# omarchy:examples=omarchy setup wsl viewer

set -euo pipefail

# The WSL desktop is served by wayvnc and shown in a VNC client. A client
# running on Windows gets a native window and, more to the point, the Windows
# clipboard: wayvnc already carries the selection both ways over
# ext_data_control_manager_v1, but a viewer running inside WSL bridges that to
# Xwayland rather than to Windows.
#
# Windows ships no VNC client, so this fetches two.
#
# TigerVNC is kept as the fallback: it is a single portable executable, and it
# speaks the extended clipboard that carries UTF-8. Its limitation is that it
# only forwards system keys in full screen (upstream issue #1899).
#
# Nothing is installed on the Linux side and no Windows setting is changed:
# both viewers live in the user's own AppData.

VIEWER_VERSION=1.16.2
VIEWER_SHA256=58396d99556026da6b906c9ed51ad6cb5c840cc3fb65e53653c52ca5a80bfad9
VIEWER_URL="https://sourceforge.net/projects/tigervnc/files/stable/$VIEWER_VERSION/vncviewer64-$VIEWER_VERSION.exe/download"

# TurboVNC is the viewer the desktop uses. Every Omarchy binding starts with
# SUPER, and Windows keeps that key for itself unless the viewer grabs the
# keyboard; TurboVNC grabs it in a window (GrabKeyboard=Always), which TigerVNC
# only does in full screen and UltraVNC only via a Scroll Lock toggle -- and
# UltraVNC cannot resize the remote desktop at all.
#
# The installer is unpacked, never run: no entry in Windows' installed
# programs, no elevation. The viewer is Java and ships its own JRE, so the
# whole app/ tree is installed rather than a single file -- VncViewer.jar needs
# turbovnchelper.dll, which is what implements the keyboard grab, beside it.
TURBOVNC_VERSION=3.3.1
TURBOVNC_SHA256=cb16f343ae39aac6fd8a6eb1c107e932bb2ff03419cb861d019cfb240896df1a
TURBOVNC_URL="https://github.com/TurboVNC/turbovnc/releases/download/$TURBOVNC_VERSION/TurboVNC-$TURBOVNC_VERSION-x64.exe"

# That installer is Inno Setup 6.x, which the innoextract in the Arch repos
# (1.9) cannot read -- it stops at "Could not determine setup data version".
# This fork can. It is fetched to a temporary directory and thrown away rather
# than installed, so the image gains no dependency for a one-off unpack.
INNOEXTRACT_SHA256=c898db2ecc282ff8d943e9868d03dd6f1fc6069ddd40430341b211f93826b360
INNOEXTRACT_URL="https://github.com/crazy-max/innoextract/releases/download/v1.13.0/innoextract-linux-amd64"

usage() {
  cat <<USAGE
Usage: omarchy setup wsl viewer [--force]

Downloads the Windows VNC viewers to your Windows profile and puts an
Omarchy shortcut on your desktop, so 'startx' opens the desktop in a native
Windows window with a shared clipboard.

  --force   re-download even when a viewer is already installed

TurboVNC $TURBOVNC_VERSION is what the desktop uses: it grabs the keyboard in
a window, which is what lets SUPER reach the session and the keybindings
work. TigerVNC $VIEWER_VERSION is installed alongside it as a fallback.

Without either the desktop still opens, in the viewer inside WSL, which
cannot reach the Windows clipboard and never receives SUPER.
USAGE
}

force=0

while (($#)); do
  case "$1" in
    --force)
      force=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

if [[ ! -d /mnt/c/Windows ]]; then
  echo "Error: this only applies to Omarchy running under WSL." >&2
  exit 1
fi

# The same interop idiom as default/wsl/oobe.sh: cmd.exe is what can answer,
# it prints a UNC working-directory warning first, and its output is CRLF.
local_app_data=$(/mnt/c/Windows/System32/cmd.exe /c "echo %LOCALAPPDATA%" 2>/dev/null | tail -1 | tr -d '\r\n')

if [[ -z $local_app_data ]]; then
  echo "Error: could not ask Windows where LOCALAPPDATA is." >&2
  echo "Check that interop is enabled in /etc/wsl.conf." >&2
  exit 1
fi

viewer_dir="$(wslpath -u "$local_app_data")/Omarchy"
viewer="$viewer_dir/vncviewer64.exe"
turbovnc_dir="$viewer_dir/TurboVNC"

# The image build cannot create this: it runs in a container with no Windows to
# write to. So it happens here, alongside the viewer, as the other half of
# setting up the Windows side.
install_shortcut() {
  local icon_dir icon script

  # The shortcut has to name the distribution wsl.exe should start, and
  # WSL_DISTRO_NAME is the only thing that knows what this was imported as.
  # defaultName in /etc/wsl-distribution.conf is not a fallback: it is the name
  # the image asks for, which is not the name it necessarily got, so guessing
  # from it produces a shortcut that starts a different distribution.
  local distro="${WSL_DISTRO_NAME:-}"

  if [[ -z $distro ]]; then
    echo "Note: WSL_DISTRO_NAME is unset -- run this from a shell inside the" >&2
    echo "distribution so the shortcut names the right one. Nothing was created." >&2
    return 0
  fi

  icon_dir="$viewer_dir"
  icon="$icon_dir/omarchy.ico"

  # install/wsl/image.sh renders this from logo.svg for the Start menu entry
  # WSL creates; the same file serves the desktop shortcut.
  if [[ -f /usr/lib/wsl/omarchy.ico ]]; then
    install -Dm644 /usr/lib/wsl/omarchy.ico "$icon"
  fi

  # wslg.exe rather than wsl.exe: it launches without a console window, so no
  # terminal flashes up behind the desktop. bash -lc so the session starts from
  # a login shell, the way it does when the user types startx themselves.
  script=$(mktemp --suffix=.ps1)
  cat >"$script" <<PS1
\$desktop = [Environment]::GetFolderPath('Desktop')
\$link = Join-Path \$desktop 'Omarchy Desktop.lnk'
\$shell = New-Object -ComObject WScript.Shell
\$sc = \$shell.CreateShortcut(\$link)
\$sc.TargetPath = 'C:\\Program Files\\WSL\\wslg.exe'
\$sc.Arguments = '-d $distro --cd ~ -- bash -lc startx'
\$sc.IconLocation = "\$env:LOCALAPPDATA\\Omarchy\\omarchy.ico,0"
\$sc.Description = 'Start the Omarchy desktop in a window'
\$sc.WorkingDirectory = \$env:USERPROFILE
\$sc.Save()
Write-Output \$link
PS1

  local link
  link=$(/mnt/c/Windows/System32/WindowsPowerShell/v1.0/powershell.exe -NoProfile -ExecutionPolicy Bypass \
    -File "$(wslpath -w "$script")" 2>/dev/null | tail -1 | tr -d '\r\n')
  rm -f "$script"

  if [[ -n $link ]]; then
    echo "Created the desktop shortcut: $link"
  else
    echo "Note: could not create the desktop shortcut; 'startx' still works." >&2
  fi
}

# Download to $1 and refuse anything whose digest is not $2. Pinning is the
# only integrity check available: neither publisher signs these files.
fetch_verified() {
  local url="$1" dest="$2" want="$3" label="$4" got

  echo "Downloading $label"

  if ! curl -fL --retry 3 --progress-bar -o "$dest" "$url"; then
    echo "Error: could not download $label from $url" >&2
    return 1
  fi

  got=$(sha256sum "$dest" | cut -d' ' -f1)

  if [[ $got != "$want" ]]; then
    echo "Error: $label does not match its expected checksum; not installing it." >&2
    echo "  expected $want" >&2
    echo "  got      $got" >&2
    return 1
  fi
}

# Unpack the viewer out of TurboVNC's installer without running it.
install_turbovnc() {
  local work extractor setup

  work=$(mktemp -d)
  extractor="$work/innoextract"
  setup="$work/TurboVNC_Setup.exe"

  if ! fetch_verified "$INNOEXTRACT_URL" "$extractor" "$INNOEXTRACT_SHA256" "innoextract"; then
    rm -rf "$work"
    return 1
  fi
  chmod +x "$extractor"

  if ! fetch_verified "$TURBOVNC_URL" "$setup" "$TURBOVNC_SHA256" "TurboVNC $TURBOVNC_VERSION"; then
    rm -rf "$work"
    return 1
  fi

  if ! "$extractor" --silent --extract --output-dir "$work/out" "$setup" >/dev/null 2>&1; then
    echo "Error: could not unpack the TurboVNC installer." >&2
    rm -rf "$work"
    return 1
  fi

  # The viewer is useless in pieces: the jar needs its helper library and the
  # bundled JRE. Check for both ends of the tree before replacing what is
  # installed, rather than leaving a half-copied directory behind.
  if [[ ! -f $work/out/app/java/VncViewer.jar ]] || [[ ! -f $work/out/app/java/jre/bin/javaw.exe ]]; then
    echo "Error: the TurboVNC installer did not contain the viewer and its JRE." >&2
    rm -rf "$work"
    return 1
  fi

  rm -rf "$turbovnc_dir"
  mkdir -p "$viewer_dir"
  cp -a "$work/out/app" "$turbovnc_dir"
  rm -rf "$work"

  echo "Installed $turbovnc_dir"
}

# UltraVNC was tried before TurboVNC and left these behind. It cannot resize
# the remote desktop, so it is not coming back.
remove_ultravnc() {
  rm -f "$viewer_dir/uvnc-vncviewer.exe" "$viewer_dir/uvnc-vncviewer.exe.disabled" \
    "$viewer_dir/options.vnc"
}

installed() {
  [[ -f $viewer ]] && [[ $(sha256sum "$viewer" | cut -d' ' -f1) == "$VIEWER_SHA256" ]]
}

turbovnc_installed() {
  [[ -f $turbovnc_dir/java/VncViewer.jar ]] && [[ -f $turbovnc_dir/java/jre/bin/javaw.exe ]]
}

remove_ultravnc

if (( force )) || ! turbovnc_installed; then
  install_turbovnc || echo "Note: TurboVNC was not installed; the desktop will use TigerVNC." >&2
else
  echo "TurboVNC $TURBOVNC_VERSION is already installed at $turbovnc_dir"
fi

if (( ! force )) && installed; then
  echo "TigerVNC $VIEWER_VERSION is already installed at $viewer"
  install_shortcut
  echo "Run 'startx' to open the desktop."
  exit 0
fi

echo "Downloading TigerVNC $VIEWER_VERSION for Windows"

download=$(mktemp)
trap 'rm -f "$download"' EXIT

# SourceForge answers with a redirect to a mirror, hence -L.
if ! curl -fL --retry 3 --progress-bar -o "$download" "$VIEWER_URL"; then
  echo "Error: could not download the viewer from $VIEWER_URL" >&2
  exit 1
fi

# SourceForge publishes no signature for this file, so the digest is pinned
# here instead. It is what makes every run after the first one -- and every
# other machine -- safe from a substituted download.
actual=$(sha256sum "$download" | cut -d' ' -f1)

if [[ $actual != "$VIEWER_SHA256" ]]; then
  echo "Error: the download does not match the expected checksum; not installing it." >&2
  echo "  expected $VIEWER_SHA256" >&2
  echo "  got      $actual" >&2
  exit 1
fi

mkdir -p "$viewer_dir"
install -m755 "$download" "$viewer"

echo
echo "Installed $viewer"

install_shortcut

echo "Run 'startx' to open the Omarchy desktop in a Windows window."
