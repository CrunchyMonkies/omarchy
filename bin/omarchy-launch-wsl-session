#!/bin/bash

# omarchy:summary=Start the Omarchy desktop in a WSLg window
# omarchy:group=launch
# omarchy:args=[--diagnose]
# omarchy:examples=start-omarchy
# omarchy:hidden=true

set -uo pipefail

# This is what `start-omarchy` runs on a WSL image (install/wsl/wslg.sh
# installs the shim). WSL never starts the desktop on its own, so this is the
# only way in.
#
# The session is not shown the way it is on hardware. WSL has no display to
# scan out to and no GPU Mesa can drive, so Hyprland renders in software onto a
# headless output, wayvnc serves that on the loopback, and a VNC viewer running
# as an ordinary WSLg client puts it in a window on the Windows desktop.
# Resizing that window resizes the desktop. docs/wsl.md covers why.

VNC_ADDRESS=127.0.0.1
VNC_PORT=5900
VNC_DESKTOP_NAME=Omarchy
HEADLESS_OUTPUT=HEADLESS-1

usage() {
  cat <<USAGE
Usage: start-omarchy [--diagnose]
       omarchy launch wsl session [--diagnose]

Starts the Omarchy Hyprland session as a window on the Windows desktop,
through WSLg.

Closing the window ends the session.

--diagnose reports what the session needs and what this machine has,
without starting anything.
USAGE
}

diagnose_only=0

while (($#)); do
  case "$1" in
    --diagnose)
      diagnose_only=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

# WSLg publishes the compositor sockets here. Without it there is no window to
# put the session in and nothing below can work.
# "locale -a" spells them without the dash and in lower case -- en_US.UTF-8 is
# listed as en_US.utf8 -- so a literal comparison against LANG never matches.
normalized_locale() {
  echo "${1//-/}" | sed 's/\.[Uu][Tt][Ff]8$/.utf8/'
}

wslg_present() {
  [[ -d /mnt/wslg ]]
}

# Whether WSLg's services are actually running, which is a different question
# from whether it is mounted: /mnt/wslg stays mounted whether or not anything
# came up behind it. WSLGd starts weston, the X server and PulseAudio together,
# so this socket standing in for all three is fair.
#
# The desktop does not need any of them -- the viewer runs on Windows and wayvnc
# serves it over the loopback -- which is why this is reported rather than
# enforced. Audio is the part with nowhere else to go: WSL has no sound hardware
# (/dev/snd carries a timer and nothing else), so PulseAudio's RDP sink is the
# only way sound leaves the machine.
wslg_audio_present() {
  [[ -S /mnt/wslg/PulseServer ]]
}

# Hyprland's backend needs a DRM device it can both allocate GBM buffers on and
# find a CRTC in. A connector entry (card0-Virtual-1) is what tells the two
# apart: dxgkrnl registers a render-only node with nothing to scan out to, and
# aquamarine rejects it with "does not support kms". VKMS is the device that
# answers, and omarchy-dev-wsl-kernel is what builds it in.
kms_device() {
  local card

  for card in /sys/class/drm/card[0-9]*; do
    [[ $card == *-* ]] && continue
    compgen -G "$card-*" >/dev/null || continue

    echo "/dev/dri/${card##*/}"
    return 0
  done

  return 1
}

# A kernel carrying the community dxgkrnl DRM patches has one of these. Mesa
# cannot load a driver for it, but aquamarine still prefers it over the KMS fd
# and then fails every dmabuf import against it: the desktop renders and screen
# capture hangs. Nothing here can undo that, so say so rather than start.
stray_render_node() {
  compgen -G "/dev/dri/renderD*" >/dev/null
}

# WSL does share the host GPU, through /dev/dxg -- a char device, not a DRM
# one, which is why it survives the render-node rule above untouched. Mesa's
# d3d12 driver drives it, and WSL mounts the host half at /usr/lib/wsl/lib and
# puts it on the linker path itself via /etc/ld.so.conf.d/ld.wsl.conf.
#
# Mesa will not find it on its own: with no DRM render node to probe there is
# nothing to auto-detect from, and it falls back to llvmpipe. The driver has to
# be named. This checks the four things that have to be there before naming it
# is worth doing; a machine with GPU support turned off is missing /dev/dxg and
# renders in software as it always did.
gpu_render_available() {
  [[ -e /dev/dxg ]] || return 1
  [[ -e /usr/lib/dri/d3d12_dri.so ]] || return 1
  [[ -e /usr/lib/wsl/lib/libd3d12core.so ]] || return 1
  [[ -e /usr/lib/wsl/lib/libdxcore.so ]] || return 1
}

# What --diagnose says about rendering. Naming the missing piece matters more
# than the verdict: "llvmpipe" alone leaves someone with a working GPU no idea
# which of the four things below their machine is short of.
render_summary() {
  if [[ ${OMARCHY_WSL_SOFTWARE_RENDER:-0} == 1 ]]; then
    echo "llvmpipe (forced by OMARCHY_WSL_SOFTWARE_RENDER)"
    return
  fi

  local missing=()
  [[ -e /dev/dxg ]] || missing+=(/dev/dxg)
  [[ -e /usr/lib/dri/d3d12_dri.so ]] || missing+=(d3d12_dri.so)
  [[ -e /usr/lib/wsl/lib/libd3d12core.so ]] || missing+=(libd3d12core.so)
  [[ -e /usr/lib/wsl/lib/libdxcore.so ]] || missing+=(libdxcore.so)

  if (( ${#missing[@]} )); then
    echo "llvmpipe — no GPU (missing ${missing[*]})"
  else
    echo "d3d12 on the host GPU through /dev/dxg"
  fi
}

# libseat is how aquamarine opens the device. logind answers on hardware, but
# it manages seats it finds on a real machine and WSL has none.
seatd_running() {
  systemctl is-active --quiet seatd.service
}

session_running() {
  pgrep -x Hyprland >/dev/null 2>&1
}

# The viewer runs on Windows when omarchy-setup-wsl-viewer has put it there.
# That is what gets the Windows clipboard: wayvnc already carries the selection
# both ways over ext_data_control_manager_v1, but a viewer inside WSL bridges it
# to Xwayland instead. Same cmd.exe idiom as default/wsl/oobe.sh.
windows_viewer_dir() {
  local local_app_data

  local_app_data=$(/mnt/c/Windows/System32/cmd.exe /c "echo %LOCALAPPDATA%" 2>/dev/null | tail -1 | tr -d '\r\n')
  [[ -n $local_app_data ]] || return 1

  echo "$(wslpath -u "$local_app_data")/Omarchy"
}

diagnose() {
  local device
  device=$(kms_device) || device=""

  echo "Omarchy WSL session diagnostics"
  echo
  echo "  kernel:      $(uname -r)"
  echo "  WSLg:        $(wslg_present && echo "present at /mnt/wslg" || echo "MISSING")"
  echo "  audio:       $(wslg_audio_present && echo "PulseAudio at /mnt/wslg/PulseServer" || echo "MISSING — no sound")"
  echo "  KMS device:  ${device:-MISSING}"
  echo "  render node: $(stray_render_node && echo "present — see below" || echo "none, as expected")"
  echo "  renderer:    $(render_summary)"
  echo "  seatd:       $(seatd_running && echo "running" || echo "NOT RUNNING")"
  echo "  session:     $(session_running && echo "Hyprland already running" || echo "not running")"
  echo

  if ! wslg_present; then
    cat <<'NOTE'
WSLg is not available in this distribution. Individual GUI apps and the
desktop both need it. Check that the Windows host is on WSL 2 with WSLg
enabled (wsl --version), and that /etc/wsl.conf has not disabled interop.
NOTE
  elif [[ -z $device ]]; then
    cat <<'NOTE'
No DRM device with a display attached. Stock WSL2 kernels ship /dev/dxg and
no DRM device at all, so Hyprland has nothing to render on and the session
will not start. Individual GUI apps still work over WSLg — this only blocks
the full desktop.

To get one, build a WSL2 kernel with VKMS turned on:

  omarchy dev wsl kernel

then point Windows at the bzImage it produces (it prints the .wslconfig
snippet) and run 'wsl --shutdown' to pick it up.
NOTE
  elif stray_render_node; then
    cat <<'NOTE'
A DRM render node is present. That means this kernel carries the community
dxgkrnl DRM patches, which Omarchy's kernel no longer applies. Mesa has no
driver for that node, but Hyprland's backend prefers it anyway and then fails
every buffer import against it — the desktop draws, and screen capture and
window resizing do not work.

Rebuild the kernel with 'omarchy dev wsl kernel' and point .wslconfig at it.
NOTE
  elif ! seatd_running; then
    cat <<'NOTE'
seatd is not running, so Hyprland cannot open the DRM device.

  sudo systemctl enable --now seatd
NOTE
  else
    echo "Everything the session needs is present. Run start-omarchy."
  fi

  # Reported after the chain above rather than inside it: no sound is a bad
  # afternoon, not a session that will not start.
  if ! wslg_audio_present; then
    cat <<'NOTE'

There is no audio. WSLg brings up weston and PulseAudio together when the
distribution starts and puts a socket at /mnt/wslg/PulseServer for clients to
reach; with that socket missing, WSLg's daemon failed and nothing can play
sound. WSL has no sound hardware, so there is no second path to fall back to.

WSLg only tries once, when the distribution starts, so a restart is what
retries it -- from Windows, naming this distribution:

  wsl.exe --terminate <distribution>

If it still has no sound after that, /mnt/wslg/stderr.log says why it failed.
WSLg sets up shared memory once per virtual machine and a distribution that
starts later can find it already taken, in which case only 'wsl.exe --shutdown'
retries it -- for every distribution, and starting this one first.
NOTE
  fi
}

if (( diagnose_only )); then
  diagnose
  exit 0
fi

if ! wslg_present; then
  echo "Error: /mnt/wslg not found — this is not a WSLg-capable WSL distribution." >&2
  echo "Run 'start-omarchy --diagnose' for details." >&2
  exit 1
fi

if session_running; then
  echo "Error: a Hyprland session is already running." >&2
  echo "Close its window (or 'omarchy system logout') before starting another." >&2
  exit 1
fi

if ! drm_device=$(kms_device); then
  echo "Error: no DRM device with a display, so Hyprland cannot start." >&2
  echo >&2
  diagnose >&2
  exit 1
fi

# On hardware the session goes through uwsm, which sources
# /usr/share/uwsm/env.d/10-omarchy and so builds the session environment. There
# is no uwsm here (see below), which makes this command the top level -- hence
# reading env-bootstrap directly rather than relying on $OMARCHY_PATH the way
# ordinary bin/ commands may. A login shell already has it from
# /etc/profile.d/omarchy.sh; "wsl -d Omarchy start-omarchy" is not a login shell.
if [[ -z ${OMARCHY_PATH:-} ]]; then
  source /usr/share/omarchy/default/bash/env-bootstrap
fi

# The other half of what env.d/10-omarchy does: TERMINAL and EDITOR.
if [[ -r $OMARCHY_PATH/default/uwsm/default ]]; then
  source "$OMARCHY_PATH/default/uwsm/default"
fi

# WSL's /init hands down the Windows locale, which is very often one this
# image has never generated -- install/wsl/locale.sh generates en_US.UTF-8, but
# Windows may be set to any of them. Passing an ungenerated LANG to the session
# makes setlocale() fail in everything it launches, so fall back to the one
# locale always present rather than hand every application a name that resolves
# to nothing.
if [[ -n ${LANG:-} ]] && ! locale -a 2>/dev/null | grep -qxF "$(normalized_locale "$LANG")"; then
  export LANG=C.UTF-8
fi

# WSLg's sockets, in case this was reached from a shell that did not read
# /etc/profile.d/omarchy-wslg.sh (systemd units, ssh, wsl -d ... command).
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/mnt/wslg/runtime-dir}"
export DISPLAY="${DISPLAY:-:0}"
export PULSE_SERVER="${PULSE_SERVER:-unix:/mnt/wslg/PulseServer}"

# WSLg's own Wayland socket is in the environment of any shell that read that
# profile drop-in, and aquamarine picks its nested Wayland backend whenever it
# sees one. That backend cannot host Hyprland: WSLg's Weston is 9.0.0 and
# advertises wl_compositor v5 against the v6 aquamarine binds. Drive the DRM
# device directly instead.
unset WAYLAND_DISPLAY

export AQ_DRM_DEVICES="$drm_device"

# Linear buffers. This arrived with the abandoned design that nested inside
# WSLg's Weston and lost its justification when that went, but it earns its
# place again here: the compositor allocates on VKMS and renders on the GPU
# below, and a linear buffer is the one both ends can agree on.
export AQ_NO_MODIFIERS=1

# The GPU, when there is one. This used to read "there is no GPU here Mesa can
# drive" and force llvmpipe, which was true of the DRM render node that idea was
# tested against and never true of /dev/dxg -- see gpu_render_available.
#
# OMARCHY_WSL_SOFTWARE_RENDER is the way back. The compositor allocating on VKMS
# and rendering on d3d12 is the same shape as the import that failed when this
# was last attempted through a dxgkrnl render node, and if it fails again it
# fails after the desktop is up, where there is nothing left to edit a file
# with. Applications are unaffected either way.
if [[ ${OMARCHY_WSL_SOFTWARE_RENDER:-0} == 1 ]] || ! gpu_render_available; then
  export LIBGL_ALWAYS_SOFTWARE=1
  export GALLIUM_DRIVER=llvmpipe
else
  export GALLIUM_DRIVER=d3d12
  # The same driver decodes video, which is what mpv and Chromium reach for.
  export LIBVA_DRIVER_NAME=d3d12
fi

export XDG_CURRENT_DESKTOP=Hyprland
export XDG_SESSION_TYPE=wayland

# hyprctl needs HYPRLAND_INSTANCE_SIGNATURE, and only the compositor and its
# children have it -- this command is the compositor's parent. Hyprland names a
# directory after the signature when it starts, so take the newest one, the way
# omarchy-restart-shell does for callers outside the session.
session_signature() {
  local hypr_dir

  hypr_dir=$(find "$XDG_RUNTIME_DIR/hypr" -mindepth 1 -maxdepth 1 -type d \
    -printf '%T@ %p\n' 2>/dev/null | sort -n | tail -n 1 | cut -d' ' -f2-)
  [[ -n $hypr_dir ]] || return 1

  echo "${hypr_dir##*/}"
}

session_ready() {
  local signature

  signature=$(session_signature) || return 1
  HYPRLAND_INSTANCE_SIGNATURE="$signature" hyprctl monitors >/dev/null 2>&1
}

vnc_listening() {
  (exec 3<>"/dev/tcp/$VNC_ADDRESS/$VNC_PORT") 2>/dev/null
}

wait_until() {
  local deadline=$((SECONDS + $1))
  shift

  while ((SECONDS < deadline)); do
    if "$@"; then
      return 0
    fi
    sleep 1
  done

  return 1
}

session_pid=""
wayvnc_pid=""
title_pid=""

# A headless output has no hardware cursor plane, so the compositor composites
# the pointer into the frame wayvnc captures. UltraVNC hides its own pointer and
# expects exactly that, so the default is to leave it on. The TigerVNC viewers
# draw a pointer of their own instead, and would show two -- so for those, and
# only those, the compositor's is turned off. hyprctl keyword does not work
# against the Lua config; eval is what it asks for.
hide_compositor_cursor() {
  hyprctl eval 'hl.config({ cursor = { invisible = true } })' >/dev/null 2>&1
}

session_gone() {
  ! kill -0 "$session_pid" 2>/dev/null
}

cleanup() {
  if [[ -n $title_pid ]]; then
    kill "$title_pid" 2>/dev/null
  fi

  if [[ -n $wayvnc_pid ]]; then
    kill "$wayvnc_pid" 2>/dev/null
  fi

  if [[ -n $session_pid ]] && kill -0 "$session_pid" 2>/dev/null; then
    # The Lua config's dispatcher form. Plain "hyprctl dispatch exit" is a
    # syntax error under it, returns 7, and leaves the session running.
    hyprctl dispatch 'hl.dsp.exit()' >/dev/null 2>&1

    # Don't let a session that ignores that strand start-omarchy in wait forever.
    wait_until 10 session_gone || kill "$session_pid" 2>/dev/null
    wait "$session_pid" 2>/dev/null
  fi
}

trap cleanup EXIT

# Which wayland-N sockets exist before the compositor adds its own. WSLg's
# wayland-0 is one of them; whatever appears next is Hyprland's, and that is how
# its socket name is found further down.
sockets_before=$(compgen -G "$XDG_RUNTIME_DIR/wayland-[0-9]*" | sort)

# On hardware this is "uwsm start -g -1 -e -D Hyprland hyprland.desktop", the
# line SDDM runs from default/wayland-sessions/omarchy.desktop. uwsm drives
# systemd user units, and WSL has no working user manager to drive: Arch's
# systemd spawns through clone3(CLONE_INTO_CGROUP), user@1000.service's cgroup
# is held populated by processes WSL keeps in another PID namespace, and the
# call fails with EBUSY every time. docs/wsl.md covers it.
#
# So the compositor is started directly, under the session bus dbus.socket
# would otherwise have provided. start-hyprland is Hyprland's own watchdog
# launcher -- running the binary bare warns against it, and the watchdog wants
# nothing from systemd or uwsm. Backgrounded rather than exec'd because the
# output and the viewer still have to be set up once it is listening.
# DISPLAY is unset for the compositor, and only for it. /etc/profile.d/omarchy-wslg.sh
# points it at WSLg's own X server so GUI apps run from a plain shell have one --
# but inside the session that server is a foreign display, and no Xwayland runs
# here to correct it. An X11 client launched from the desktop connects there
# instead and its window never appears in the session: VS Code starts, six
# processes and all, and shows nothing. Unset, toolkits pick Wayland, and
# Hyprland provides its own Xwayland for what still needs X.
#
# The launcher keeps its own DISPLAY: the in-WSL viewer below is an X11 client
# of WSLg and needs exactly the one being withheld here.
#
# XDG_SESSION_TYPE comes through as "unspecified" without a display manager to
# set it, which is how Electron decides to try X11 first.
env -u DISPLAY XDG_SESSION_TYPE=wayland dbus-run-session -- start-hyprland &
session_pid=$!

if ! wait_until 60 session_ready; then
  echo "Error: the Hyprland session did not come up." >&2
  echo "Run 'start-omarchy --diagnose', and see 'omarchy debug' for the session log." >&2
  exit 1
fi

export HYPRLAND_INSTANCE_SIGNATURE=$(session_signature)

# wayvnc only resizes an output whose name starts with HEADLESS-, and the VKMS
# output cannot take a custom mode: it offers the fixed list a driver with no
# EDID gets and nothing else. So the desktop lives on a headless output, which
# accepts whatever size the viewer window asks for. install/wsl/hypr.sh is what
# disables the VKMS one, in config so a theme reload cannot bring it back.
hyprctl output create headless >/dev/null

# The socket that appeared while the compositor was starting.
wayland_display=$(comm -13 <(echo "$sockets_before") \
  <(compgen -G "$XDG_RUNTIME_DIR/wayland-[0-9]*" | sort) | head -n 1)
wayland_display=${wayland_display##*/}

if [[ -z $wayland_display ]]; then
  echo "Error: the session opened no Wayland socket, so it cannot be served." >&2
  exit 1
fi

# default/hypr/autostart.lua does this on hyprland.start, but as
# "dbus-update-activation-environment --systemd --all", which needs the user
# manager and so fails here. Without it the xdg-desktop-portal backends are
# activated with no WAYLAND_DISPLAY and cannot reach the compositor.
WAYLAND_DISPLAY="$wayland_display" dbus-update-activation-environment \
  WAYLAND_DISPLAY DISPLAY XDG_RUNTIME_DIR XDG_CURRENT_DESKTOP XDG_SESSION_TYPE OMARCHY_PATH \
  >/dev/null 2>&1

# Loopback only. WSL2 forwards localhost from Windows, so the viewer reaches it
# either way, and binding wider would put an unauthenticated desktop on the LAN.
# --name is what the viewer titles its window. Without it that window is called
# WayVNC, naming the transport rather than the desktop it is showing.
WAYLAND_DISPLAY="$wayland_display" wayvnc --name="$VNC_DESKTOP_NAME" \
  -o "$HEADLESS_OUTPUT" "$VNC_ADDRESS" "$VNC_PORT" &
wayvnc_pid=$!

if ! wait_until 30 vnc_listening; then
  echo "Error: wayvnc did not start serving the session." >&2
  exit 1
fi

# From here the title follows the focused window, the way a window manager
# titles its own. Started after wayvnc is listening, because it talks to it.
omarchy-hyprland-vnc-title-watch "$VNC_DESKTOP_NAME" &
title_pid=$!

# Neither viewer needs dmabuf or negotiates a Wayland protocol version, which
# is why showing the session over VNC works where nesting the compositor in
# WSLg's Weston does not.
#
# RemoteResize is on, so dragging the window resizes the desktop. The viewer
# logs "SetDesktopSize failed: 4" when it does; that is misleading. Result 4 is
# neatvnc's "request forwarded", not a refusal -- wayvnc applies the resize
# asynchronously and answers again with "success".
#
# AcceptClipboard/SendClipboard are on by default; they are named anyway
# because a shared clipboard is the reason the Windows viewer is preferred, and
# a default is a quiet thing to depend on.
#
# AlwaysCursor draws the pointer locally. hide_compositor_cursor above turns the
# compositor's cursor off, because a headless output has no hardware cursor
# plane: the compositor composites the cursor into the framebuffer, wayvnc
# forwards it as well, and the viewer ends up showing two. With the compositor
# one off, wayvnc sends an invisible cursor and this is what puts a real one
# back -- drawn by the client, so it costs no round trip.
# TigerVNC's dialect. RemoteResize is on, so dragging the window resizes the
# desktop; the viewer logs "SetDesktopSize failed: 4" when it does, which is
# misleading -- 4 is neatvnc's "request forwarded", and wayvnc then applies it.
tigervnc_options=(
  -RemoteResize=1
  -AcceptClipboard=1
  -SendClipboard=1
  -AlwaysCursor=1
  -CursorType=System
)

viewer_dir=$(windows_viewer_dir) || viewer_dir=""
turbovnc_jar="$viewer_dir/TurboVNC/java/VncViewer.jar"

# TurboVNC first: it is the only one of the three that grabs the keyboard in a
# window, and without a grab Windows keeps SUPER for itself and every Omarchy
# binding is dead. TigerVNC grabs only in full screen (upstream issue #1899).
#
# The viewer is Java with its own JRE. This is what vncviewer.bat does, minus
# the console window: javaw rather than java, and java.library.path pointing at
# turbovnchelper.dll, which is what implements the grab.
#
# host::port, with two colons -- a single colon means a display number, so
# 127.0.0.1:5900 would be port 11800.
#
# DesktopSize=Auto resizes the desktop to the window. That needs the patched
# neatvnc built by install/wsl/neatvnc.sh: stock neatvnc never announces the
# screen layout at connect, so TurboVNC concludes resizing is unsupported at
# its first framebuffer update and disables it permanently. The clipboard is
# ServerKeyMap is off so the viewer sends X11 keysyms rather than raw
# scancodes. With the scancode path the right Super key arrives as evdev 95
# (the Japanese keypad comma, NoSymbol) instead of 126, because the viewer
# drops the extended bit from the E0 5C that Windows reports -- so it sets no
# modifier and no binding fires. Keysyms are layout independent and name the
# key outright, which is what wayvnc looks up.
#
# Scale is pinned to 100 because the viewer persists parameters between runs,
# and any automatic scaling silently disables desktop resizing -- the two are
# mutually exclusive. The clipboard is left to
# its defaults, which are on both ways: RecvClipboard and SendClipboard are
# boolean parameters that take no value, and "-RecvClipboard 1" makes the
# viewer read the 1 as the host and sit on a connection dialog instead. That
# is also why the toolbar is turned off with -noToolbar rather than
# "-Toolbar 0", which the viewer rejects outright.
if [[ -n $viewer_dir ]] && [[ -f $turbovnc_jar ]]; then
  echo "CTRL-ALT-SHIFT-G toggles the keyboard grab; SUPER needs it held." >&2
  "$viewer_dir/TurboVNC/java/jre/bin/javaw.exe" \
    -Dsun.java2d.d3d=false \
    "-Djava.library.path=$(wslpath -w "$viewer_dir/TurboVNC/java")" \
    -jar "$(wslpath -w "$turbovnc_jar")" \
    -reqarch amd64 \
    -GrabKeyboard Always \
    -SecurityTypes None \
    -DesktopSize Auto \
    -Scale 100 \
    -noServerKeyMap \
    -noToolbar \
    "$VNC_ADDRESS::$VNC_PORT"
elif [[ -n $viewer_dir ]] && [[ -f $viewer_dir/vncviewer64.exe ]]; then
  echo "Using TigerVNC: SUPER only reaches the desktop in full screen (F8 to toggle)." >&2
  echo "'omarchy setup wsl viewer' installs UltraVNC, which sends it in a window." >&2
  hide_compositor_cursor
  "$viewer_dir/vncviewer64.exe" -SecurityTypes=None "${tigervnc_options[@]}" "$VNC_ADDRESS:$VNC_PORT"
else
  echo "No Windows VNC viewer found, so the desktop opens in the one inside WSL." >&2
  echo "That one cannot reach the Windows clipboard and never receives SUPER;" >&2
  echo "'omarchy setup wsl viewer' installs one that can." >&2
  hide_compositor_cursor
  vncviewer -SecurityTypes None "${tigervnc_options[@]}" "$VNC_ADDRESS:$VNC_PORT"
fi
